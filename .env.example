# Public RPC endpoint for browser reads. Use a provider URL from your dashboard.
# Do not put private API secrets in frontend environment variables.
VITE_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional Jupiter API key. Never expose a secret key in a public frontend.
# If your Jupiter plan requires a secret credential, proxy requests through a backend.
VITE_JUPITER_API_BASE=https://api.jup.ag/swap/v1
VITE_JUPITER_API_KEY=
